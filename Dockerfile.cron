FROM python:3.10-slim

WORKDIR /app

RUN apt-get update && apt-get install -y cron curl && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir \
    boto3==1.28.53 \
    python-dateutil \
    pytz \
    requests==2.31.0 \
    python-dotenv

COPY ./app ./app
RUN mkdir -p /app/logs

ENV BAILEYS_URL=http://wppconnect-bot:3005
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app

RUN echo "0 8 * * * root cd /app && python3 /app/app/whatsapp/whatsapp_birthday_service.py >> /app/logs/cron.log 2>&1" > /etc/cron.d/birthday-cron
RUN chmod 0644 /etc/cron.d/birthday-cron
RUN crontab /etc/cron.d/birthday-cron
RUN touch /app/logs/cron.log

CMD ["cron", "-f"]
