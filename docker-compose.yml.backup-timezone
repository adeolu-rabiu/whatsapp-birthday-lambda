services:
  python-api:
    build:
      context: .
      dockerfile: Dockerfile.api
    container_name: whatsapp-birthday-lambda_python-api
    ports:
    - 5000:5000
    env_file:
    - .env
    volumes:
    - ./logs:/app/logs
    - ./app:/app/app
    - ${HOME}/.aws:/root/.aws:ro
    restart: unless-stopped
    healthcheck:
      test:
      - CMD-SHELL
      - curl -fsS http://localhost:5000/health || exit 1
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 10s
    networks:
    - birthday-network
  wppconnect-bot:
    build:
      context: ./wppconnect-server
      dockerfile: Dockerfile
    container_name: wppconnect-bot
    ports:
    - 3005:3005
    volumes:
    - ./wppconnect-server:/app
    - /app/node_modules
    - ./wppconnect-server/tokens:/app/tokens
    - ./wppconnect-server/chrome-profile:/app/profile
    - ${HOME}/.aws:/root/.aws:ro
    command: |
      sh -c ' 
        echo "🧹 Cleaning Chrome lock files..."
        find /app/tokens -type f -name "Singleton*" -delete 2>/dev/null || true
        find /app/tokens -type s -name "Singleton*" -delete 2>/dev/null || true
        find /app/profile -type f -name "Singleton*" -delete 2>/dev/null || true
        find /app/profile -type s -name "Singleton*" -delete 2>/dev/null || true
        rm -f /app/profile/SingletonLock /app/profile/SingletonSocket /app/profile/SingletonCookie 2>/dev/null || true
        mkdir -p /app/profile
        echo "✅ Lock files cleaned, starting server..."
        node server.js'
    environment:
      PUPPETEER_EXECUTABLE_PATH: /usr/bin/chromium
      PUPPETEER_ARGS: --no-sandbox --disable-setuid-sandbox --disable-dev-shm-usage
        --disable-gpu --no-first-run --no-default-browser-check --user-data-dir=/app/profile
    shm_size: 1gb
    restart: unless-stopped
    networks:
    - birthday-network
    healthcheck:
      test:
      - CMD
      - curl
      - -f
      - http://localhost:3005/health
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 30s
  web-ui:
    build:
      context: ./web-ui/birthday-manager
      dockerfile: Dockerfile
    container_name: whatsapp-birthday-lambda_web-ui
    ports:
    - 3000:3000
    env_file:
    - ./web-ui/birthday-manager/.env
    depends_on:
    - python-api
    volumes:
    - ./web-ui/birthday-manager:/app
    - /app/node_modules
    stdin_open: true
    tty: true
    restart: unless-stopped
    networks:
    - birthday-network
  dashboard:
    build:
      context: ./dashboard
    container_name: whatsapp-birthday-lambda-dashboard
    environment:
    - API_BASE=http://python-api:5000
    depends_on:
    - python-api
    ports:
    - 8080:8080
    restart: unless-stopped
    networks:
    - birthday-network
    healthcheck:
      test:
      - CMD-SHELL
      - curl -fsS http://localhost:8080/health || exit 1
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 10s
  cron:
    build:
      context: .
      dockerfile: Dockerfile.cron
    container_name: whatsapp-birthday-lambda_cron
    volumes:
    - ./logs:/app/logs
    - ${HOME}/.aws:/root/.aws:ro
    environment:
      BAILEYS_URL: http://wppconnect-bot:3005
      CRON_SCHEDULE: 0 8 * * *
      PYTHONUNBUFFERED: '1'
      AWS_REGION: eu-west-2
      DYNAMODB_TABLE_NAME: Birthdays
    depends_on:
    - python-api
    - wppconnect-bot
    restart: unless-stopped
    networks:
    - birthday-network
  prometheus:
    image: quay.io/prometheus/prometheus:v2.55.1
    container_name: prometheus
    command:
    - --config.file=/etc/prometheus/prometheus.yml
    - --storage.tsdb.path=/prometheus
    - --web.enable-lifecycle
    volumes:
    - ./monitoring/prometheus/prometheus.yml:/etc/prometheus/prometheus.yml:ro
    - ./monitoring/prometheus/alerts.yml:/etc/prometheus/alerts.yml:ro
    - prometheus-data:/prometheus
    ports:
    - 9090:9090
    networks:
    - birthday-network
    restart: unless-stopped
    extra_hosts:
    - host.docker.internal:${HOST_DOCKER_INTERNAL}
  alertmanager:
    image: quay.io/prometheus/alertmanager:v0.27.0
    container_name: alertmanager
    command:
    - --config.file=/etc/alertmanager/alertmanager.yml
    - --storage.path=/alertmanager
    - --web.external-url=http://localhost:9093
    ports:
    - 9093:9093
    volumes:
    - ./monitoring/alertmanager.yml:/etc/alertmanager/alertmanager.yml:ro
    - alertmanager-data:/alertmanager
    networks:
    - birthday-network
    restart: unless-stopped
  grafana:
    image: grafana/grafana:11.2.0
    container_name: grafana
    environment:
    - GF_SECURITY_ADMIN_USER=${GRAFANA_ADMIN_USER:-admin}
    - GF_SECURITY_ADMIN_PASSWORD=${GRAFANA_ADMIN_PASSWORD:-admin}
    volumes:
    - grafana-data:/var/lib/grafana
    - ./monitoring/grafana/provisioning:/etc/grafana/provisioning:ro
    ports:
    - 3001:3000
    networks:
    - birthday-network
    restart: unless-stopped
    depends_on:
    - prometheus
  node-exporter:
    image: quay.io/prometheus/node-exporter:v1.8.1
    container_name: node-exporter
    networks:
    - birthday-network
    restart: unless-stopped
    command:
    - --path.rootfs=/host
    - --collector.textfile.directory=/host/var/lib/node_exporter/textfile
    volumes:
    - /:/host:ro,rslave
    ports:
    - 9100:9100
  cadvisor:
    image: gcr.io/cadvisor/cadvisor:v0.49.1
    container_name: cadvisor
    ports:
    - 8081:8080
    networks:
    - birthday-network
    restart: unless-stopped
    volumes:
    - /:/rootfs:ro
    - /var/run:/var/run:ro
    - /sys:/sys:ro
    - /var/lib/docker/:/var/lib/docker:ro
  blackbox:
    image: quay.io/prometheus/blackbox-exporter:v0.25.0
    container_name: blackbox
    ports:
    - 9115:9115
    networks:
    - birthday-network
    restart: unless-stopped
    command:
    - --config.file=/etc/blackbox/blackbox.yml
    volumes:
    - ./monitoring/blackbox.yml:/etc/blackbox/blackbox.yml:ro
  vmware-exporter:
    image: pryorda/vmware_exporter:latest
    container_name: vmware-exporter
    environment:
    - VSPHERE_HOST=${VSPHERE_HOST}
    - VSPHERE_USER=${VSPHERE_USER}
    - VSPHERE_PASSWORD=${VSPHERE_PASSWORD}
    - VSPHERE_IGNORE_SSL=${VSPHERE_IGNORE_SSL:-true}
    ports:
    - 9272:9272
    networks:
    - birthday-network
    restart: unless-stopped
networks:
  birthday-network:
    driver: bridge
    external: true
    name: whatsapp-birthday-lambda_birthday-network
volumes:
  prometheus-data: null
  grafana-data: null
  alertmanager-data: null
