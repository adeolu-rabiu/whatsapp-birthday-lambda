FROM python:3.10-slim
WORKDIR /app
RUN pip install --no-cache-dir boto3==1.28.53 python-dateutil pytz requests==2.31.0 pytest==8.3.5 mock==5.2.0 python-dotenv moto==4.1.3 Flask gunicorn flask-cors
COPY . .
# Create a simple Flask wrapper to expose the service via HTTP
RUN echo 'from flask import Flask, jsonify, request\nimport os\nimport subprocess\nimport threading\nfrom flask_cors import CORS\n\napp = Flask(__name__)\nCORS(app)\n\n@app.route("/health")\ndef health():\n    return jsonify({"status": "ok"})\n\n@app.route("/birthdays")\ndef get_birthdays():\n    return jsonify([])\n\n@app.route("/groups")\ndef get_groups():\n    return jsonify([])\n\n@app.route("/send-birthday-messages", methods=["POST"])\ndef send_messages():\n    thread = threading.Thread(target=lambda: subprocess.run(["python", "app/whatsapp/whatsapp_birthday_service.py"]))\n    thread.start()\n    return jsonify({"status": "messages sending in background"})\n\nif __name__ == "__main__":\n    app.run(host="0.0.0.0", port=5000)' > app/app.py
# Start Flask server
CMD ["python", "app/app.py"]
