{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    {"type":"grafana","id":"grafana","name":"Grafana","version":"10.0.0"},
    {"type":"panel","id":"stat","name":"Stat","version":""},
    {"type":"panel","id":"gauge","name":"Gauge","version":""},
    {"type":"panel","id":"timeseries","name":"Time series","version":""},
    {"type":"panel","id":"table","name":"Table","version":""},
    {"type":"datasource","id":"prometheus","name":"Prometheus","version":""}
  ],
  "annotations": {"list":[]},
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "iteration": 1,
  "links": [],
  "refresh": "10s",
  "schemaVersion": 39,
  "style": "dark",
  "tags": ["infra","docker"],
  "templating": {
    "list": [
      {
        "type": "query",
        "name": "project",
        "label": "project",
        "hide": 0,
        "datasource": {"type":"prometheus","uid":"${DS_PROMETHEUS}"},
        "query": "label_values(container_last_seen, container_label_com_docker_compose_project)",
        "refresh": 2,
        "multi": true,
        "includeAll": false,
        "options": []
      },
      {
        "type": "query",
        "name": "container",
        "label": "container",
        "hide": 0,
        "datasource": {"type":"prometheus","uid":"${DS_PROMETHEUS}"},
        "query": "label_values(container_cpu_usage_seconds_total{container_label_com_docker_compose_project=\"$project\"}, name)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "options": []
      }
    ]
  },
  "time": {"from":"now-6h","to":"now"},
  "timepicker": {},
  "timezone": "",
  "title": "Infra Overview",
  "uid": "infra-overview",
  "version": 1,
  "panels": [
    {
      "type": "stat",
      "title": "Running containers",
      "gridPos": {"h":4,"w":8,"x":0,"y":0},
      "datasource": {"type":"prometheus","uid":"${DS_PROMETHEUS}"},
      "targets": [
        {
          "expr": "count( count by (name) ( container_last_seen{container_label_com_docker_compose_project=\"$project\"} ))",
          "refId": "A"
        }
      ],
      "options": {"reduceOptions":{"calcs":["lastNotNull"],"values":false},"orientation":"auto"}
    },
    {
      "type": "stat",
      "title": "Total CPU Usage",
      "gridPos": {"h":4,"w":8,"x":8,"y":0},
      "datasource": {"type":"prometheus","uid":"${DS_PROMETHEUS}"},
      "fieldConfig":{"defaults":{"unit":"percent"},"overrides":[]},
      "targets": [
        {
          "expr": "100 - (avg by(instance)(irate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
          "refId": "A"
        }
      ],
      "options": {"reduceOptions":{"calcs":["lastNotNull"]}}
    },
    {
      "type": "stat",
      "title": "Total Memory Usage",
      "gridPos": {"h":4,"w":8,"x":16,"y":0},
      "datasource": {"type":"prometheus","uid":"${DS_PROMETHEUS}"},
      "fieldConfig":{"defaults":{"unit":"gibibytes"},"overrides":[]},
      "targets": [
        {
          "expr": "(node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes) / 1024^3",
          "refId": "A"
        }
      ],
      "options": {"reduceOptions":{"calcs":["lastNotNull"]}}
    },

    {"type":"gauge","title":"CPU Busy %","gridPos":{"h":5,"w":6,"x":0,"y":4},
      "datasource":{"type":"prometheus","uid":"${DS_PROMETHEUS}"},
      "fieldConfig":{"defaults":{"unit":"percent"},"overrides":[]},
      "targets":[{"expr":"100 - (avg by(instance)(irate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)","refId":"A"}]
    },
    {"type":"gauge","title":"System Load (1m)","gridPos":{"h":5,"w":6,"x":6,"y":4},
      "datasource":{"type":"prometheus","uid":"${DS_PROMETHEUS}"},
      "targets":[{"expr":"node_load1","refId":"A"}]
    },
    {"type":"gauge","title":"RAM Used %","gridPos":{"h":5,"w":6,"x":12,"y":4},
      "datasource":{"type":"prometheus","uid":"${DS_PROMETHEUS}"},
      "fieldConfig":{"defaults":{"unit":"percent"},"overrides":[]},
      "targets":[{"expr":"(1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes) * 100","refId":"A"}]
    },
    {"type":"gauge","title":"Swap Used %","gridPos":{"h":5,"w":6,"x":18,"y":4},
      "datasource":{"type":"prometheus","uid":"${DS_PROMETHEUS}"},
      "fieldConfig":{"defaults":{"unit":"percent"},"overrides":[]},
      "targets":[{"expr":"(1 - node_memory_SwapFree_bytes / node_memory_SwapTotal_bytes) * 100","refId":"A"}]
    },
    {"type":"gauge","title":"Root FS Used % (/)","gridPos":{"h":5,"w":6,"x":0,"y":9},
      "datasource":{"type":"prometheus","uid":"${DS_PROMETHEUS}"},
      "fieldConfig":{"defaults":{"unit":"percent"},"overrides":[]},
      "targets":[{"expr":"100 * (1 - node_filesystem_free_bytes{mountpoint=\"/\",fstype!~\"tmpfs|overlay\"} / node_filesystem_size_bytes{mountpoint=\"/\",fstype!~\"tmpfs|overlay\"})","refId":"A"}]
    },

    {
      "type":"timeseries",
      "title":"CPU % per container",
      "gridPos":{"h":8,"w":24,"x":0,"y":14},
      "datasource":{"type":"prometheus","uid":"${DS_PROMETHEUS}"},
      "fieldConfig":{"defaults":{"unit":"percent"},"overrides":[]},
      "options":{"legend":{"displayMode":"list","placement":"bottom"},"tooltip":{"mode":"multi"}},
      "targets":[
        {
          "expr":"100 * sum by (name)( rate(container_cpu_usage_seconds_total{image!=\"\",container_label_com_docker_compose_project=\"$project\"}[5m]) ) / count(node_cpu_seconds_total{mode=\"system\"})",
          "refId":"A",
          "legendFormat":"{{name}}"
        }
      ]
    },
    {
      "type":"timeseries",
      "title":"Memory MiB per container",
      "gridPos":{"h":8,"w":24,"x":0,"y":22},
      "datasource":{"type":"prometheus","uid":"${DS_PROMETHEUS}"},
      "fieldConfig":{"defaults":{"unit":"mebibytes"},"overrides":[]},
      "options":{"legend":{"displayMode":"list","placement":"bottom"},"tooltip":{"mode":"multi"}},
      "targets":[
        {
          "expr":"container_memory_usage_bytes{image!=\"\",container_label_com_docker_compose_project=\"$project\"} / 1024^2",
          "refId":"A",
          "legendFormat":"{{name}}"
        }
      ]
    },
    {
      "type":"timeseries",
      "title":"Network Rx (B/s) per container",
      "gridPos":{"h":8,"w":12,"x":0,"y":30},
      "datasource":{"type":"prometheus","uid":"${DS_PROMETHEUS}"},
      "fieldConfig":{"defaults":{"unit":"Bps"},"overrides":[]},
      "options":{"legend":{"displayMode":"list","placement":"bottom"},"tooltip":{"mode":"multi"}},
      "targets":[
        {
          "expr":"sum by (name)( rate(container_network_receive_bytes_total{image!=\"\",container_label_com_docker_compose_project=\"$project\"}[5m]) )",
          "refId":"A",
          "legendFormat":"{{name}}"
        }
      ]
    },
    {
      "type":"timeseries",
      "title":"Network Tx (B/s) per container",
      "gridPos":{"h":8,"w":12,"x":12,"y":30},
      "datasource":{"type":"prometheus","uid":"${DS_PROMETHEUS}"},
      "fieldConfig":{"defaults":{"unit":"Bps"},"overrides":[]},
      "options":{"legend":{"displayMode":"list","placement":"bottom"},"tooltip":{"mode":"multi"}},
      "targets":[
        {
          "expr":"sum by (name)( rate(container_network_transmit_bytes_total{image!=\"\",container_label_com_docker_compose_project=\"$project\"}[5m]) )",
          "refId":"A",
          "legendFormat":"{{name}}"
        }
      ]
    },

    {
      "type":"table",
      "title":"HTTP health (blackbox)",
      "gridPos":{"h":7,"w":24,"x":0,"y":38},
      "datasource":{"type":"prometheus","uid":"${DS_PROMETHEUS}"},
      "targets":[{"expr":"probe_success{job=\"blackbox-http\"}","refId":"A"}],
      "transformations":[{"id":"organize","options":{"excludeByName":{},"indexByName":{},"renameByName":{}}}],
      "fieldConfig":{
        "defaults":{},
        "overrides":[
          {
            "matcher":{"id":"byName","options":"Value"},
            "properties":[
              {"id":"mappings","value":[{"type":"value","options":{"0":{"index":0,"text":"DOWN","color":"red"},"1":{"index":1,"text":"UP","color":"green"}}}]}
            ]
          }
        ]
      }
    }
  ]
}

