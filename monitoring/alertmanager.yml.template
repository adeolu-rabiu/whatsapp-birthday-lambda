global:
  resolve_timeout: 5m

route:
  receiver: 'slack'
  group_by: ['alertname', 'instance']
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 3h

receivers:
  - name: 'slack'
    slack_configs:
      - api_url: '${SLACK_WEBHOOK_URL}'  # ← Environment variable
        channel: '#alerts'
        send_resolved: true
        username: 'Birthday Bot Alerts'
        icon_emoji: ':birthday:'
        title: '[{{ .Status | toUpper }}] {{ .GroupLabels.alertname }}'
        text: |
          *Alert:* {{ .CommonAnnotations.summary }}
          *Description:* {{ .CommonAnnotations.description }}
          *Details:*
          {{ range .Alerts }}
          • {{ .Labels.instance }} ({{ .Labels.severity }})
          {{ end }}
