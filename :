function add_group() {
  log_info "Adding a new WhatsApp group..."
  
  # Get input from user
  read -p "Enter group name: " name
  read -p "Enter group description (optional): " description
  
  if [ -z "$name" ]; then
    log_error "Group name is required"
    return 1
  fi
  
  # Prepare JSON payload
  JSON_PAYLOAD="{\"name\":\"$name\""
  
  if [ -n "$description" ]; then
    JSON_PAYLOAD="$JSON_PAYLOAD,\"description\":\"$description\""
  fi
  
  JSON_PAYLOAD="$JSON_PAYLOAD}"
  
  # Try to add group using API
  AUTH_TOKEN="$REACT_APP_AUTH_TOKEN"
  RESPONSE=$(curl -s -X POST \
    -H "Content-Type: application/json" \
    -H "Authorization: Bearer $AUTH_TOKEN" \
    -d "$JSON_PAYLOAD" \
    "$API_URL/groups")
  
  if [ $? -ne 0 ] || [[ "$RESPONSE" == *"error"* ]]; then
    log_error "Failed to add group."
    log_error "Response: $RESPONSE"
    return 1
  fi
  
  log_success "WhatsApp group added successfully!"
  echo "$RESPONSE"
}

