#!/bin/bash

# WhatsApp Birthday Bot Service Manager
# Version 4.0 - Updated for Docker Compose with Lambda API integration

# Set error handling
set -e

# Colors for better readability
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

# Get the absolute path of the project root directory
PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Default Docker Compose project name
COMPOSE_PROJECT_NAME="whatsapp-birthday-lambda"

# Log to file function for error tracking
function log_to_file() {
  local log_level="$1"
  local message="$2"
  local timestamp=$(date "+%Y-%m-%d %H:%M:%S")
  echo "[$timestamp] [$log_level] $message" >> "$PROJECT_ROOT/service_manager_errors.log"
}

# URLs
API_URL=""
REACT_APP_API_URL=""
LOCAL_UI_URL=""
BAILEYS_SERVER_PORT=3005
REACT_APP_PORT=3000
PYTHON_API_PORT=5000

function log_success() {
  echo -e "${GREEN}✅ $1${NC}"
}

function log_warning() {
  echo -e "${YELLOW}⚠️ $1${NC}"
}

function log_error() {
  echo -e "${RED}❌ $1${NC}"
}

function log_info() {
  echo -e "${BLUE}📌 $1${NC}"
}

function log_highlight() {
  echo -e "${PURPLE}🔍 $1${NC}"
}

function log_cmd() {
  echo -e "${CYAN}🖥️ $1${NC}"
}

function ensure_log_files() {
  # Ensure log directories exists
  mkdir -p "$PROJECT_ROOT/logs"
  
  # Create log files if they don't exist
  touch "$PROJECT_ROOT/logs/service_manager.log"
  
  log_success "Log files are ready"
}

function ensure_env_file() {
  if [ ! -f "$PROJECT_ROOT/web-ui/birthday-manager/.env" ]; then
    log_warning "React .env file not found! Creating one with default values."
    cat <<EOT > "$PROJECT_ROOT/web-ui/birthday-manager/.env"
REACT_APP_API_URL=https://5b9qzf6vs0.execute-api.eu-west-2.amazonaws.com
REACT_APP_AUTH_TOKEN=2e58df99b9011ea1257bef6c0026bc3b9a2daa3543ff6b8f241c129f09646a7a
EOT
    log_success "React .env file created. Please review and update it as needed."
  fi
  
  # Export environment variables
  if [ -f "$PROJECT_ROOT/web-ui/birthday-manager/.env" ]; then
    set -o allexport
    source "$PROJECT_ROOT/web-ui/birthday-manager/.env"
    set +o allexport
    log_info "Loaded environment variables from .env"
  fi
  
  # Ensure API_URL is set
  if [ -n "$REACT_APP_API_URL" ]; then
    API_URL="$REACT_APP_API_URL"
    log_info "API URL set to: $API_URL"
    log_to_file "INFO" "API URL loaded from .env: $API_URL"
  else
    API_URL="https://5b9qzf6vs0.execute-api.eu-west-2.amazonaws.com"
    log_warning "API URL not found in .env, using default: $API_URL"
    log_to_file "WARNING" "Using default API URL: $API_URL"
  fi
  
  # Make sure AUTH_TOKEN is loaded
  if [ -z "$REACT_APP_AUTH_TOKEN" ]; then
    REACT_APP_AUTH_TOKEN="2e58df99b9011ea1257bef6c0026bc3b9a2daa3543ff6b8f241c129f09646a7a"
    log_warning "AUTH_TOKEN not found in .env, using default"
    log_to_file "WARNING" "Using default AUTH_TOKEN"
  else
    log_info "Authorization token loaded from .env"
    log_to_file "INFO" "AUTH_TOKEN loaded from .env"
  fi
  
  LOCAL_UI_URL="http://localhost:$REACT_APP_PORT"
}

function check_docker() {
  if ! command -v docker &> /dev/null; then
    log_error "Docker is not installed. Please install Docker first."
    exit 1
  fi
  
  if ! command -v docker-compose &> /dev/null; then
    log_error "Docker Compose is not installed. Please install Docker Compose first."
    exit 1
  fi
  
  log_success "Docker and Docker Compose are installed."
  
  # Check if Docker daemon is running
  if ! docker info &>/dev/null; then
    log_error "Docker daemon is not running. Please start Docker first."
    exit 1
  fi
  
  log_success "Docker daemon is running."
}

function check_services() {
  log_info "Checking Docker services status..."
  
  # Get a list of all expected services
  EXPECTED_SERVICES=("web-ui" "python-api" "elasticsearch" "kibana" "filebeat" "baileys-bot" "dashboard" "cron")
  
  for service in "${EXPECTED_SERVICES[@]}"; do
    if docker ps --format '{{.Names}}' | grep -q "${COMPOSE_PROJECT_NAME}_${service}"; then
      log_success "${service} is running"
    else
      log_warning "${service} is not running"
    fi
  done
}

function docker_compose_up() {
  log_info "Starting all Docker containers..."
  
  cd "$PROJECT_ROOT"
  
  # Check if docker-compose.yml exists
  if [ ! -f "$PROJECT_ROOT/docker-compose.yml" ]; then
    log_error "docker-compose.yml not found in $PROJECT_ROOT"
    return 1
  fi
  
  # Start all services with Docker Compose
  docker-compose up -d
  
  if [ $? -eq 0 ]; then
    log_success "All Docker containers started successfully"
    sleep 5  # Give containers time to initialize
    check_services
  else
    log_error "Failed to start Docker containers"
    return 1
  fi
  
  # Provide URL for UI access
  log_info "Web UI available at: http://localhost:$REACT_APP_PORT"
  log_info "Python API available at: http://localhost:$PYTHON_API_PORT"
  log_info "WhatsApp Baileys API available at: http://localhost:$BAILEYS_SERVER_PORT"
}

function docker_compose_down() {
  log_info "Stopping all Docker containers..."
  
  cd "$PROJECT_ROOT"
  
  # Stop all services with Docker Compose
  docker-compose down
  
  if [ $? -eq 0 ]; then
    log_success "All Docker containers stopped successfully"
  else
    log_error "Failed to stop Docker containers"
    return 1
  fi
}

function docker_compose_restart() {
  log_info "Restarting all Docker containers..."
  
  cd "$PROJECT_ROOT"
  
  # Restart all services with Docker Compose
  docker-compose restart
  
  if [ $? -eq 0 ]; then
    log_success "All Docker containers restarted successfully"
    sleep 5  # Give containers time to initialize
    check_services
  else
    log_error "Failed to restart Docker containers"
    return 1
  fi
}

function restart_single_service() {
  log_info "Restarting a specific Docker service..."
  
  # List available services
  echo "Available services:"
  docker-compose ps --services | nl
  
  read -p "Enter the number of the service to restart: " service_num
  
  # Get the service name
  service_name=$(docker-compose ps --services | sed "${service_num}q;d")
  
  if [ -z "$service_name" ]; then
    log_error "Invalid service number"
    return 1
  fi
  
  log_info "Restarting $service_name..."
  docker-compose restart "$service_name"
  
  if [ $? -eq 0 ]; then
    log_success "$service_name restarted successfully"
  else
    log_error "Failed to restart $service_name"
    return 1
  fi
}

function open_web_ui() {
  log_info "Opening Web UI in browser..."
  
  if [ -n "$BROWSER" ]; then
    $BROWSER "http://localhost:3000" &
  elif command -v xdg-open &> /dev/null; then
    xdg-open "http://localhost:3000" &
  elif command -v open &> /dev/null; then
    open "http://localhost:3000" &
  elif command -v start &> /dev/null; then
    start "http://localhost:3000" &
  else
    log_warning "Could not automatically open browser. Please visit http://localhost:3000 manually."
  fi
}

function view_docker_logs() {
  log_info "Viewing Docker logs..."
  
  # List available services
  echo "Available services:"
  docker-compose ps --services | nl
  
  read -p "Enter the number of the service to view logs (0 for all): " service_num
  
  if [ "$service_num" = "0" ]; then
    log_info "Viewing logs for all services (press Ctrl+C to exit)..."
    docker-compose logs -f
  else
    # Get the service name
    service_name=$(docker-compose ps --services | sed "${service_num}q;d")
    
    if [ -z "$service_name" ]; then
      log_error "Invalid service number"
      return 1
    fi
    
    log_info "Viewing logs for $service_name (press Ctrl+C to exit)..."
    docker-compose logs -f "$service_name"
  fi
}

function display_birthdays() {
  log_info "Fetching birthdays from API..."
  
  # Try using API endpoint with proper authentication
  AUTH_TOKEN="$REACT_APP_AUTH_TOKEN"
  RESPONSE=$(curl -s -H "Authorization: Bearer $AUTH_TOKEN" "$API_URL/birthdays")
  
  if [ $? -ne 0 ] || [[ "$RESPONSE" == *"error"* ]]; then
    log_error "Failed to fetch birthdays from API."
    log_error "Response: $RESPONSE"
    return 1
  fi
  
  # Display birthdays nicely if jq is available
  echo -e "${BLUE}📋 Current Birthdays:${NC}"
  
  if command -v jq &> /dev/null; then
    echo "$RESPONSE" | jq -r '.[] | "👤 Name: \(.name)\n🎂 Birth Date: \(.birth_date)\n🗓️ Month-Day: \(.birth_month_day)\n🔖 ID: \(.birthday_id)\n📱 Group ID: \(.group_id)\n---"'
  else
    echo "$RESPONSE"
  fi
}

function display_groups() {
  log_info "Fetching WhatsApp groups from API..."
  
  # Try using API endpoint with proper authentication
  AUTH_TOKEN="$REACT_APP_AUTH_TOKEN"
  RESPONSE=$(curl -s -H "Authorization: Bearer $AUTH_TOKEN" "$API_URL/groups")
  
  if [ $? -ne 0 ] || [[ "$RESPONSE" == *"error"* ]]; then
    log_error "Failed to fetch groups from API."
    log_error "Response: $RESPONSE"
    return 1
  fi
  
  # Display groups nicely if jq is available
  echo -e "${BLUE}📋 WhatsApp Groups:${NC}"
  
  if command -v jq &> /dev/null; then
    echo "$RESPONSE" | jq -r '.[] | "📱 Name: \(.name)\n🔖 ID: \(.group_id)\n📝 Description: \(.description // "No description")\n---"'
  else
    echo "$RESPONSE"
  fi
}

function test_send_message() {
  log_info "Testing message sending..."
  
  # First get available groups
  display_groups
  
  # Get input from user
  read -p "Enter the group ID to send to: " group_id
  read -p "Enter the message to send: " message
  
  if [ -z "$group_id" ] || [ -z "$message" ]; then
    log_error "Group ID and message are required"
    return 1
  fi
  
  # Try to send message using API
  AUTH_TOKEN="$REACT_APP_AUTH_TOKEN"
  RESPONSE=$(curl -s -X POST \
    -H "Content-Type: application/json" \
    -H "Authorization: Bearer $AUTH_TOKEN" \
    -d "{\"group_id\":\"$group_id\",\"message\":\"$message\"}" \
    "$API_URL/test-message")
  
  if [ $? -ne 0 ] || [[ "$RESPONSE" == *"error"* ]]; then
    log_error "Failed to send message."
    log_error "Response: $RESPONSE"
    return 1
  fi
  
  log_success "Message sent successfully!"
  echo "$RESPONSE"
}

function add_birthday() {
  log_info "Adding a new birthday..."
  
  # Get input from user
  read -p "Enter person's name: " name
  read -p "Enter birth date (YYYY-MM-DD): " birth_date
  
  # Display available groups for selection
  display_groups
  read -p "Enter the group ID: " group_id
  
  if [ -z "$name" ] || [ -z "$birth_date" ] || [ -z "$group_id" ]; then
    log_error "Name, birth date, and group ID are required"
    return 1
  fi
  
  # Extract month and day for birth_month_day
  month_day=$(echo "$birth_date" | cut -d'-' -f2,3)
  
  # Try to add birthday using API
  AUTH_TOKEN="$REACT_APP_AUTH_TOKEN"
  RESPONSE=$(curl -s -X POST \
    -H "Content-Type: application/json" \
    -H "Authorization: Bearer $AUTH_TOKEN" \
    -d "{\"name\":\"$name\",\"birth_date\":\"$birth_date\",\"birth_month_day\":\"$month_day\",\"group_id\":\"$group_id\"}" \
    "$API_URL/birthdays")
  
  if [ $? -ne 0 ] || [[ "$RESPONSE" == *"error"* ]]; then
    log_error "Failed to add birthday."
    log_error "Response: $RESPONSE"
    return 1
  fi
  
  log_success "Birthday added successfully!"
  echo "$RESPONSE"
}

