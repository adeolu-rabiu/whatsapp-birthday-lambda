function fix_react_bug() {
  log_info "Fixing React birthday form bug..."
  
  # Path to the BirthdayForm.js file
  FORM_PATH="$PROJECT_ROOT/web-ui/birthday-manager/src/components/BirthdayForm.js"
  
  if [ ! -f "$FORM_PATH" ]; then
    log_error "BirthdayForm.js not found at $FORM_PATH"
    return 1
  fi
  
  # Check if the bug is present (using groupId instead of group_id in addBirthday)
  if grep -q "groupId" "$FORM_PATH"; then
    log_info "Found potential bug in BirthdayForm.js, applying fix..."
    
    # Create a backup first
    cp "$FORM_PATH" "${FORM_PATH}.bak"
    
    # Replace the bug with the fix
    sed -i 's/groupId/group_id: groupId/g' "$FORM_PATH"
    
    log_success "Fix applied to BirthdayForm.js"
    log_info "Restarting web-ui container to apply changes..."
    
    docker-compose restart web-ui
    
    if [ $? -eq 0 ]; then
      log_success "web-ui container restarted successfully"
    else
      log_error "Failed to restart web-ui container"
    fi
  else
    log_info "No bug found in BirthdayForm.js or fix already applied"
  fi
}

