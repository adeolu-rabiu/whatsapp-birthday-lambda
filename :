}

function create_vnc_access() {
  log_info "Setting up VNC access for GUI applications in container..."
  
  # Check if VNC is already installed
  if docker-compose exec web-ui which vncserver &>/dev/null; then
    log_info "VNC server already installed"
  else
    log_info "Installing VNC server in web-ui container..."
    docker-compose exec web-ui bash -c "apt-get update && apt-get install -y tightvncserver xfce4 xfce4-goodies"
    
    if [ $? -ne 0 ]; then
      log_error "Failed to install VNC server in container"
      return 1
    fi
  fi
  
  # Setup VNC server
  log_info "Setting up VNC server in web-ui container..."
  docker-compose exec web-ui bash -c "mkdir -p ~/.vnc && echo 'password' | vncpasswd -f > ~/.vnc/passwd && chmod 600 ~/.vnc/passwd"
  
  # Create startup file
  docker-compose exec web-ui bash -c "echo '#!/bin/bash\nxrdb \$HOME/.Xresources\nstartxfce4 &' > ~/.vnc/xstartup && chmod +x ~/.vnc/xstartup"
  
  # Start VNC server
  docker-compose exec -d web-ui bash -c "vncserver -geometry 1280x800 :1"
  
  log_success "VNC server started in web-ui container"
  log_info "You can now connect to VNC at localhost:5901 with password 'password'"
  log_info "You may need to expose port 5901 in your docker-compose.yml file for external access"
}

function configure_port_forwarding() {
  log_info "Setting up SSH port forwarding for remote access..."
  
  # Get the local IP address
  LOCAL_IP=$(hostname -I | awk '{print $1}')
  
  log_info "Your server IP address is: $LOCAL_IP"
  log_info "To access the UI remotely, use the following SSH command on your local machine:"
  echo -e "${CYAN}ssh -L 8080:localhost:3000 user@${LOCAL_IP}${NC}"
  echo -e "Then access the UI at ${CYAN}http://localhost:8080${NC} on your local machine"
  
  # Offer to create a simple script for port forwarding
  read -p "Create a port forwarding setup script? (y/n): " create_script
  
  if [[ "$create_script" =~ ^[Yy]$ ]]; then
    cat > "$PROJECT_ROOT/port_forward_setup.sh" << EOF
#!/bin/bash
echo "Setting up port forwarding for WhatsApp Birthday Bot UI"
echo "Running this on your local machine will allow you to access the UI"
echo "Usage: ./port_forward_setup.sh [username] [custom_local_port]"

USERNAME=\${1:-"user"}
LOCAL_PORT=\${2:-"8080"}

echo "SSH command: ssh -L \${LOCAL_PORT}:localhost:3000 \${USERNAME}@${LOCAL_IP}"
echo "After connecting, access the UI at: http://localhost:\${LOCAL_PORT}"

read -p "Connect now? (y/n): " connect_now
if [[ "\$connect_now" =~ ^[Yy]$ ]]; then
  ssh -L \${LOCAL_PORT}:localhost:3000 \${USERNAME}@${LOCAL_IP}
fi
EOF
    chmod +x "$PROJECT_ROOT/port_forward_setup.sh"
    log_success "Port forwarding setup script created: $PROJECT_ROOT/port_forward_setup.sh"
  fi
}

function system_health_check() {
  clear
  echo -e "${BLUE}🩺 System Health Check${NC}"
  
  # Check Docker status
  echo -e "${PURPLE}=== Docker Status ===${NC}"
  docker info | grep "Containers\|Running\|Paused\|Stopped\|Images"
  
  # Check Docker containers
  echo -e "\n${PURPLE}=== Container Status ===${NC}"
  docker-compose ps
  
  # Check disk space
  echo -e "\n${PURPLE}=== Disk Space ===${NC}"
  if command -v df &> /dev/null; then
    df -h . | awk 'NR==1 || NR==2 {print}'
  else
    log_warning "Disk space check not available"
  fi
  
  # Check Docker disk usage
  echo -e "\n${PURPLE}=== Docker Disk Usage ===${NC}"
  docker system df
  
  # Check API connectivity
  echo -e "\n${PURPLE}=== API Connectivity ===${NC}"
  curl -s -o /dev/null -w "API Status: %{http_code}\n" -H "Authorization: Bearer ${REACT_APP_AUTH_TOKEN}" "${API_URL}/birthdays"
  
  # Check local services connectivity
  echo -e "\n${PURPLE}=== Local Services Connectivity ===${NC}"
  curl -s -o /dev/null -w "Web UI Status: %{http_code}\n" "http://localhost:3000"
  curl -s -o /dev/null -w "Python API Status: %{http_code}\n" "http://localhost:5000/birthdays"
  curl -s -o /dev/null -w "Baileys Status: %{http_code}\n" "http://localhost:3005/health"
  
  read -p "Press Enter to continue..." dummy
}

